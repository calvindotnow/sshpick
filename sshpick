#!/bin/sh
# sshpick: a floating SSH host picker for Rex, backed by ~/.ssh/config.
# https://github.com/calvindotnow/sshpick

VERSION=0.2.0
RAW_URL=https://raw.githubusercontent.com/calvindotnow/sshpick/main/sshpick
CONFIG=${SSHPICK_CONFIG:-$HOME/.ssh/config}
case "$CONFIG" in /*) ;; *) CONFIG=$PWD/$CONFIG ;; esac
BOUNDS=${SSHPICK_BOUNDS:-0.15,0.12,0.7,0.7}  # popup x,y,w,h as fractions of the window
STATE=${SSHPICK_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/sshpick}  # favorites, recent, sort
MARK="# added by sshpick"  # marks the blocks sshpick wrote, which are the ones it can edit
TAB=$(printf '\t')
US=$(printf '\037')
REX=$(command -v rex || echo "$HOME/.local/bin/rex")
JQ=$(command -v jq || echo /usr/bin/jq)
SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
export SELF

ssh() { command ssh ${SSHPICK_CONFIG:+-F "$CONFIG"} "$@"; }

need() {
    if [ -n "$INLINE" ]; then set -- fzf; else set -- fzf "$JQ" "$REX"; fi
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null || { echo "sshpick: missing $(basename "$cmd")" >&2; exit 1; }
    done
    v=$(fzf --version | cut -d' ' -f1)
    [ "$(printf '0.65\n%s\n' "$v" | sort -V | head -n1)" = 0.65 ] ||
        { echo "sshpick: needs fzf 0.65 or newer (found $v)" >&2; exit 1; }
}

update() {  # replace this script with the latest version from GitHub
    tmp=$(mktemp "$SELF.XXXXXX") || exit 1
    if ! curl -fsSL "$RAW_URL" -o "$tmp"; then
        rm -f "$tmp"; echo "sshpick: download failed" >&2; exit 1
    fi
    new=$(sed -n 's/^VERSION=//p' "$tmp" | head -n1)
    if [ -z "$new" ] || ! sh -n "$tmp" 2>/dev/null; then
        rm -f "$tmp"; echo "sshpick: the download doesn't look right, not updating" >&2; exit 1
    fi
    if [ "$(printf '%s\n%s\n' "$new" "$VERSION" | sort -V | tail -n1)" = "$VERSION" ]; then
        rm -f "$tmp"; echo "sshpick $VERSION is up to date"; exit 0
    fi
    chmod +x "$tmp" && mv "$tmp" "$SELF" && echo "sshpick updated: $VERSION → $new"
}

open_popup() {  # 0 = popup opened over this Rex window
    [ -n "$REX_SESSION" ] || return 1
    win=$("$REX" block inspect -s "$REX_SESSION" "$REX_BLOCK" --json 2>/dev/null | "$JQ" -r '.block.window_id // empty')
    "$JQ" -n --arg self "$SELF" --arg win "$win" --arg bounds "$BOUNDS" \
          --arg cfg "${SSHPICK_CONFIG:+$CONFIG}" --arg state "$SSHPICK_STATE" '{
        bounds: ($bounds | split(",") | map(tonumber)), focus: true,
        layout: {block: {flavor: "com.superlogical.terminal.shell", label: "sshpick",
                         options: {command: (["env"]
                             + (if $cfg != "" then ["SSHPICK_CONFIG=\($cfg)"] else [] end)
                             + (if $state != "" then ["SSHPICK_STATE=\($state)"] else [] end)
                             + [$self, "--here"])}}}
    } + (if $win != "" then {window_id: $win} else {} end)' |
        "$REX" api call -s "$REX_SESSION" session.new_layer - >/dev/null
}

switch_to() {  # switch_to <session_id> [window_id]: show it in the Rex app (needs Remote Control)
    client=$("$REX" client ls --json 2>/dev/null | "$JQ" -r --arg s "$REX_SESSION" '
        [.clients[] | select(.info.kind == "app")]
        | (map(select(.session_ids // [] | index($s))) + .)[0].client_id // empty')
    [ -n "$client" ] || return 0
    "$REX" -C "$client" do session.select session_id="$1" ${2:+window_id="$2"} >/dev/null 2>&1 ||
        { echo "Couldn't switch sessions: turn on Remote Control in Rex Settings > Rex Server."; sleep 2; }
}

session_id() {  # session_id <label>
    "$REX" ls --json 2>/dev/null |
        "$JQ" -r --arg s "$1" '[.sessions[] | select(.label == $s)][0].session_id // empty'
}

find_tab() {  # find_tab <alias> <session label>: prints "<session_id> <window_id> <connected|dropped>"
    sid=$(session_id "$2")
    [ -n "$sid" ] || return 0
    "$REX" window ls -s "$sid" --json 2>/dev/null |
        "$JQ" -r --arg h "$1" '.windows[] | select(.label == $h) | "\(.window_id) \(.layers[0].blocks[0].block_id)"' |
        while read -r win block; do
            state=$("$REX" block call -s "$sid" -b "$block" process 2>/dev/null | "$JQ" -r '
                if .child == null then empty elif .foreground.name == "ssh" then "connected" else "dropped" end')
            [ -n "$state" ] && { echo "$sid $win $state"; break; }
        done
}

ssh_session() {  # ssh_session <alias>: what each tab runs; offers to reconnect if the connection drops
    while :; do
        ssh "$1"
        rc=$?
        [ $rc -eq 255 ] || exit $rc  # 255 is ssh's own failure; anything else is the remote shell exiting
        printf '\n\033[33mConnection to %s lost.\033[0m  r reconnect · any other key closes\n' "$1"
        old=$(stty -g); stty -icanon -echo
        key=$(dd bs=1 count=1 2>/dev/null)
        stty "$old"
        [ "$key" = r ] || exit $rc
    done
}

config_files() {  # config_files <file> [depth]: the file plus everything it Includes
    [ -f "$1" ] || return 0
    echo "$1"
    [ "${2:-0}" -lt 8 ] || return 0
    awk 'tolower($1)=="include" {for (i=2; i<=NF; i++) print $i}' "$1" | while read -r pattern; do
        case "$pattern" in
            "~/"*) pattern=$HOME/${pattern#"~/"} ;;
            /*)    ;;
            *)     pattern=$HOME/.ssh/$pattern ;;
        esac
        for f in $pattern; do config_files "$f" $((${2:-0} + 1)); done
    done
}

list_hosts() {
    config_files "$CONFIG" | while read -r f; do
        awk 'tolower($1)=="host" {for (i=2; i<=NF; i++) if ($i !~ /[*?!]/) print $i}' "$f"
    done | sort -u
}

load_hosts() {  # cache alias, tag, user, hostname, port, proxyjump per host in $RUN/hosts
    [ -s "$RUN/hosts" ] && return
    g=$RUN/g.$$ && mkdir -p "$g"
    list_hosts | (cd "$g" && xargs -P 8 -I % sh -c 'f=$1; shift; ssh "$@" -G "$f" > "$f" 2>/dev/null' sh % \
        ${SSHPICK_CONFIG:+-F "$CONFIG"} 2>/dev/null)
    (cd "$g" && for f in *; do [ -s "$f" ] && echo "$f"; done | while read -r f; do
        awk -v h="$f" '{v[$1]=$2} END {
            printf "%s\t%s\t%s\t%s\t%s\t%s\n", h, (v["tag"] ? v["tag"] : "ssh"), v["user"], v["hostname"], v["port"], v["proxyjump"]
        }' "$f"
    done) > "$g.out" && mv "$g.out" "$RUN/hosts"
    rm -rf "$g"
}

host_line() {  # host_line <alias>: its cached alias<TAB>tag<TAB>user<TAB>hostname<TAB>port<TAB>proxyjump
    load_hosts
    awk -F'\t' -v h="$1" '$1 == h' "$RUN/hosts"
}

sort_mode() { m=$(cat "$STATE/sort" 2>/dev/null); echo "${m:-recent}"; }

list_label() {  # list_label <filter>
    printf ' Hosts: %s · %s ' "${1:-all}" "$(sort_mode | sed 's/alpha/A–Z/')"
}

tag_header() {  # the tag list, with the active filter highlighted
    filter=$(cat "$RUN/filter" 2>/dev/null)
    for t in $(cat "$RUN/tags"); do
        if [ "$t" = "${filter:-all}" ]; then printf '\033[1;33m%s\033[0m ' "$t"; else printf '%s ' "$t"; fi
    done
}

set_filter() {  # set_filter <tag>: print the fzf actions that show it
    echo "$1" > "$RUN/filter"
    echo "change-list-label($(list_label "$1"))+change-header($(tag_header))+reload($SELF --rows)"
}

step_filter() {  # step_filter <1|-1>: move to the next or previous tag
    set_filter "$(awk -v cur="$(cat "$RUN/filter")" -v d="$1" '{
        for (i=1; i<=NF; i++) if ($i == cur) c = i
        print $(((c - 1 + d + NF) % NF) + 1)
    }' "$RUN/tags")"
}

list_rows() {  # alias<TAB>tag<TAB>display: favorites first, then by last connect or A–Z
    load_hosts
    mkdir -p "$STATE" && touch "$STATE/favorites" "$STATE/recent"
    if [ "$(sort_mode)" = alpha ]; then keys="-k1,1n -k3,3"; else keys="-k1,1n -k2,2nr -k3,3"; fi
    awk -F'\t' -v OFS='\t' -v filter="$(cat "$RUN/filter" 2>/dev/null)" '
        FILENAME == ARGV[1] { fav[$0] = 1; next }
        FILENAME == ARGV[2] { last[$2] = $1; next }
        filter == "" || filter == "all" || $2 == filter {
            print (($1 in fav) ? 0 : 1), (($1 in last) ? last[$1] : 0), $1, $2, $3, $4
        }' "$STATE/favorites" "$STATE/recent" "$RUN/hosts" |
        sort -t "$TAB" $keys |
        awk -F'\t' '{
            star = ($1 == 0) ? "\033[33m★\033[0m" : " "
            printf "%s\t%s\t%s %-18s \033[36m%-10s\033[0m \033[2m%s@%s\033[0m\n", $3, $4, star, $3, $4, $5, $6
        }'
    printf '+add\t-\t  \033[32m+ add new host\033[0m\n'
}

toggle_favorite() {
    [ "$1" = "+add" ] && return
    mkdir -p "$STATE" && touch "$STATE/favorites"
    if grep -qxF -- "$1" "$STATE/favorites"; then
        grep -vxF -- "$1" "$STATE/favorites" > "$STATE/favorites.tmp"
    else
        { cat "$STATE/favorites"; echo "$1"; } > "$STATE/favorites.tmp"
    fi
    mv "$STATE/favorites.tmp" "$STATE/favorites"
}

forget() {  # forget <alias> [keep-favorite]: drop it from recent (and favorites)
    [ -d "$STATE" ] || return 0
    awk -F'\t' -v h="$1" '$2 != h' "$STATE/recent" > "$STATE/recent.tmp" 2>/dev/null
    mv "$STATE/recent.tmp" "$STATE/recent"
    [ -n "$2" ] || { grep -vxF -- "$1" "$STATE/favorites" > "$STATE/favorites.tmp" 2>/dev/null
                     mv "$STATE/favorites.tmp" "$STATE/favorites"; }
}

rename_state() {  # rename_state <old> <new>: carry a renamed host's favorite and history over
    [ -d "$STATE" ] && [ "$1" != "$2" ] || return 0
    awk -F'\t' -v OFS='\t' -v o="$1" -v n="$2" '$2 == o {$2 = n} 1' "$STATE/recent" > "$STATE/recent.tmp" 2>/dev/null
    mv "$STATE/recent.tmp" "$STATE/recent"
    awk -v o="$1" -v n="$2" '$0 == o {$0 = n} 1' "$STATE/favorites" > "$STATE/favorites.tmp" 2>/dev/null
    mv "$STATE/favorites.tmp" "$STATE/favorites"
}

touch_recent() {
    mkdir -p "$STATE" && forget "$1" keep-favorite
    printf '%s\t%s\n' "$(date +%s)" "$1" >> "$STATE/recent"
}

info() {
    if [ "$1" = "+add" ]; then
        printf 'Add a host to ~/.ssh/config\n\n\033[2m⏎  start\033[0m\n'; return
    fi
    line=$(host_line "$1")
    IFS="$TAB" read -r _ tag u n port jump <<EOF
$line
EOF
    printf '%-10s %s\n' user "$u" hostname "$n" port "$port" tag "$tag"
    [ "$jump" != none ] && [ -n "$jump" ] && printf '%-10s %s\n' proxyjump "$jump"
    echo
    state=
    [ -z "$INLINE" ] && set -- "$1" $(find_tab "$1" "$tag") && state=$4
    case "$state" in
        connected) printf '\033[32m●\033[0m open in \033[36m%s\033[0m\n\n' "$tag" ;;
        dropped)   printf '\033[33m○\033[0m disconnected in \033[36m%s\033[0m\n\n' "$tag" ;;
    esac
    if [ -n "$state" ]; then
        printf '\033[2m⏎  jump to tab\n⌥⏎ new tab\033[0m\n'
    else
        printf '\033[2m⏎  connect\033[0m\n'
    fi
    is_editable "$1" && printf '\033[2m^e edit\033[0m\n'
}

menu() {  # menu <label> <header> <option>...: prints the chosen option, 1 = esc
    label=$1 header=$2; shift 2
    printf '%s\n' "$@" | fzf --style=full --layout=reverse --border=rounded \
        --margin=20%,15% --no-input --info=hidden --border-label=" $label " \
        --header="$header"
}

in_config() {  # 0 = <alias> is defined in $CONFIG itself, not an Included file
    awk -v h="$1" 'tolower($1)=="host" {for (i=2; i<=NF; i++) if ($i == h) f = 1} END {exit !f}' "$CONFIG" 2>/dev/null
}

is_editable() {  # 0 = <alias> is a block sshpick wrote
    awk -v m="$MARK" -v h="$1" 'prev == m && $0 == "Host " h {f = 1} {prev = $0} END {exit !f}' "$CONFIG" 2>/dev/null
}

remove_block() {  # remove_block <alias>: delete an sshpick block and its marker
    awk -v m="$MARK" -v h="$1" '
        skip { if (tolower($1)=="host" || tolower($1)=="match" || $0 == m) skip = 0; else next }
        held { held = 0; if ($0 == "Host " h) { skip = 1; next } print m }
        $0 == m { held = 1; next }
        { print }
        END { if (held) print m }' "$CONFIG" |
        sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' > "$CONFIG.tmp" &&
        cat "$CONFIG.tmp" > "$CONFIG" && rm -f "$CONFIG.tmp"
}

delete_host() {
    if ! in_config "$1"; then
        file=$(config_files "$CONFIG" | while read -r f; do
            awk -v h="$1" 'tolower($1)=="host" {for (i=2; i<=NF; i++) if ($i == h) f = 1} END {exit !f}' "$f" && echo "$f"
        done | head -n1)
        menu "Can't delete '$1'" "$(printf 'It comes from an Included file:\n%s' "${file:-unknown}" | sed "s|^$HOME|~|")" OK >/dev/null
        return 0
    fi
    choice=$(menu "Delete '$1'?" "" Cancel Delete) || return 0
    [ "$choice" = Delete ] || return 0
    cp "$CONFIG" "$CONFIG.bak"
    if is_editable "$1"; then
        remove_block "$1"
    else
        awk -v h="$1" '
            tolower($1)=="host" || tolower($1)=="match" {
                skip = 0
                if (tolower($1)=="host") {
                    out = ""; n = 0
                    for (i=2; i<=NF; i++) if ($i != h) { out = out " " $i; n++ }
                    if (n == 0)   { skip = 1; next }        # sole name: drop the block
                    if (n < NF-1) { print $1 out; next }    # shared line: drop just the name
                }
            }
            !skip' "$CONFIG.bak" > "$CONFIG"
    fi
    forget "$1"
    rm -f "$RUN/hosts"
}

# The add/edit form is one fzf instance: enter/shift-tab run `sshpick --form-*`,
# which validates, saves the field to $FORM_DIR/<n>, and tells fzf what to show next.
FIELD_NAMES="Alias HostName User Port Tag IdentityFile"

field_label() {
    case "$1" in
        0) echo "Alias" ;;            1) echo "HostName (IP or domain)" ;;
        2) echo "User" ;;             3) echo "Port" ;;
        4) echo "Tag / Rex session (blank = ssh)" ;;
        5) echo "IdentityFile (blank = default)" ;;
    esac
}

form_summary() {
    step=$(cat "$FORM_DIR/step") i=0
    for name in $FIELD_NAMES; do
        if [ $i -eq "$step" ]; then mark='\033[33m›\033[0m'; else mark=' '; fi
        printf "$mark %-13s %s\n" "$name" "$(cat "$FORM_DIR/$i")"
        i=$((i + 1))
    done
}

form_goto() {  # print the fzf actions that show field $1 (6 = submit)
    [ "$1" -ge 6 ] && { echo accept; return; }
    echo "$1" > "$FORM_DIR/step"
    printf 'change-input-label( %s )+change-header()+reload(%s --form-summary)+change-query:%s\n' \
        "$(field_label "$1")" "$SELF" "$(cat "$FORM_DIR/$1")"
}

form_next() {  # form_next <query>: validate and save the current field, then advance
    step=$(cat "$FORM_DIR/step") v=$1 err=
    case $step in
        0) case "$v" in
               "")            err="Alias is required" ;;
               *[[:space:]]*) err="No spaces allowed" ;;
               "$(cat "$FORM_DIR/orig")") ;;
               *) list_hosts | grep -qxF -- "$v" && err="'$v' already exists" ;;
           esac ;;
        1) [ -n "$v" ] || err="HostName is required" ;;
        2) v=${v:-$USER} ;;
        3) v=${v:-22}; case "$v" in *[!0-9]*) err="Port must be a number" ;; esac ;;
    esac
    [ -n "$err" ] && { echo "change-header:! $err"; return; }
    printf '%s' "$v" > "$FORM_DIR/$step"
    form_goto $((step + 1))
}

form_prev() {  # form_prev <query>: keep what was typed, go back one field
    step=$(cat "$FORM_DIR/step")
    [ "$step" -gt 0 ] || return
    printf '%s' "$1" > "$FORM_DIR/$step"
    form_goto $((step - 1))
}

form() {  # form <title>: edits alias..key in place, 1 = cancelled (values untouched)
    FORM_DIR=$(mktemp -d) && export FORM_DIR
    printf '%s' "$alias" > "$FORM_DIR/orig"
    i=0
    for v in "$alias" "$hostname" "$user" "$port" "$tag" "$key"; do
        printf '%s' "$v" > "$FORM_DIR/$i"; i=$((i + 1))
    done
    echo 0 > "$FORM_DIR/step"
    form_summary | fzf --ansi --style=full --layout=reverse --border=rounded \
        --disabled --no-sort --info=hidden --pointer=' ' --query "$alias" \
        --border-label=" $1 " --input-label=" Alias " --list-label=' Host ' \
        --footer='enter next · shift-tab back · esc cancel' \
        --bind "enter:transform($SELF --form-next {q})" \
        --bind "btab:transform($SELF --form-prev {q})" \
        --bind 'up:ignore,down:ignore,tab:ignore' >/dev/null
    rc=$?
    if [ $rc -eq 0 ]; then
        alias=$(cat "$FORM_DIR/0") hostname=$(cat "$FORM_DIR/1") user=$(cat "$FORM_DIR/2")
        port=$(cat "$FORM_DIR/3")  tag=$(cat "$FORM_DIR/4")      key=$(cat "$FORM_DIR/5")
    fi
    rm -rf "$FORM_DIR"
    return $rc
}

read_block() {  # read_block <alias>: load an sshpick block's values into the form variables
    alias=$1
    IFS="$US" read -r hostname user port tag key <<EOF
$(awk -v h="$1" -v m="$MARK" -v us="$US" '
    $0 == "Host " h { b = 1; next }
    b && (tolower($1)=="host" || tolower($1)=="match" || $0 == m) { b = 0 }
    b && NF { v[tolower($1)] = $2 }
    END { print v["hostname"] us v["user"] us (v["port"] ? v["port"] : 22) us v["tag"] us v["identityfile"] }' "$CONFIG")
EOF
}

truncate_config() {  # drop everything after line $lines_before
    head -n "$lines_before" "$CONFIG" > "$CONFIG.tmp" &&
        cat "$CONFIG.tmp" > "$CONFIG" && rm -f "$CONFIG.tmp"
}

write_block() {  # (re)write this host's block at the end of the config
    truncate_config
    {
        printf '\n%s\nHost %s\n    HostName %s\n    User %s\n' "$MARK" "$alias" "$hostname" "$user"
        [ "$port" != 22 ] && echo "    Port $port"
        [ -n "$tag" ]     && echo "    Tag $tag"
        [ -n "$key" ]     && printf '    IdentityFile %s\n    IdentitiesOnly yes\n' "$key"
    } >> "$CONFIG"
}

verify_host() {  # 0 = ok, 1 = failed, 2 = reachable but key login failed
    set -- "$1" $(ssh -G "$1" 2>/dev/null | awk '
        $1=="hostname"{h=$2} $1=="port"{p=$2} $1=="proxyjump"{j=$2}
        END {print h, p, (j ? j : "none")}')
    if [ "$4" = "none" ]; then
        printf 'Checking %s:%s ... ' "$2" "$3"
        nc -z -G 5 "$2" "$3" >/dev/null 2>&1 ||
            { echo "unreachable"; echo "(host down, DNS, firewall, or wrong port)"; return 1; }
        echo "port open"
    fi
    printf 'Checking SSH login ... '
    err=$(ssh -o BatchMode=yes -o ConnectTimeout=8 \
              -o StrictHostKeyChecking=accept-new "$1" true 2>&1 >/dev/null) &&
        { echo "ok"; return 0; }
    case "$err" in
        *"Permission denied"*) echo "reachable, but key login failed"; return 2 ;;
        *"IDENTIFICATION HAS CHANGED"*|*"Host key verification failed"*)
            echo "HOST KEY MISMATCH: known_hosts has a different key"; return 1 ;;
        *) echo "failed:"; echo "$err" | tail -n 3 | sed 's/^/    /'; return 1 ;;
    esac
}

host_flow() {  # host_flow [alias]: add a host, or edit one sshpick added; 0 = connect to $host
    old=$1
    if [ -n "$old" ]; then
        read_block "$old"; title="Edit host"; undo="Undo changes"
    else
        alias= hostname= user=$USER port=22 tag= key=; title="Add host"; undo=Remove
    fi
    form "$title" || return 1

    mkdir -p "$(dirname "$CONFIG")" && touch "$CONFIG" && chmod 600 "$CONFIG"
    cp "$CONFIG" "$RUN/config.before"
    [ -n "$old" ] && remove_block "$old"
    [ -n "$(tail -c1 "$CONFIG")" ] && echo >> "$CONFIG"
    lines_before=$(wc -l < "$CONFIG")
    write_block

    while :; do
        printf '\033[2J\033[HVerifying %s ...\n' "$alias"
        rcfile=$(mktemp)
        result=$( { verify_host "$alias"; echo $? > "$rcfile"; } | tee /dev/tty )
        rc=$(cat "$rcfile"); rm -f "$rcfile"
        if [ $rc -eq 0 ]; then
            [ -n "$old" ] && rename_state "$old" "$alias"
            choice=$(menu "'$alias' verified" "$result" "Connect now" "Back to list") || return 1
            [ "$choice" = "Connect now" ] && host=$alias && return 0
            return 1
        fi
        if [ $rc -eq 2 ]; then
            choice=$(menu "'$alias' failed" "$result" "Copy key (ssh-copy-id)" Edit "Try again" "Keep anyway" "$undo")
        else
            choice=$(menu "'$alias' failed" "$result" Edit "Try again" "Keep anyway" "$undo")
        fi || choice="Keep anyway"
        case "$choice" in
            Copy*)  pub=${key:+${key%.pub}.pub}
                    case "$pub" in "~/"*) pub=$HOME/${pub#"~/"} ;; esac
                    printf '\033[2J\033[H'
                    ssh-copy-id ${SSHPICK_CONFIG:+-F "$CONFIG"} ${pub:+-i "$pub"} "$alias" ;;
            Edit)   form "Edit host" && write_block ;;
            Keep*)  [ -n "$old" ] && rename_state "$old" "$alias"; return 1 ;;
            Remove) truncate_config; return 1 ;;
            Undo*)  cat "$RUN/config.before" > "$CONFIG"; return 1 ;;
        esac
    done
}

connect() {  # connect <alias> [new]: jump to the host's open tab, or open a new one
    line=$(host_line "$1")
    IFS="$TAB" read -r _ session _ <<EOF
$line
EOF
    session=${session:-ssh}
    if [ -z "$2" ]; then
        tab=$(find_tab "$1" "$session")
        [ -n "$tab" ] && { set -- $tab; switch_to "$1" "$2"; return; }
    fi
    id=$(session_id "$session")
    if [ -n "$id" ]; then
        win=$("$REX" window new -s "$id" "$1" --json -- env ${SSHPICK_CONFIG:+SSHPICK_CONFIG="$CONFIG"} "$SELF" --session "$1" | "$JQ" -r '.window_id // empty')
    else
        out=$("$REX" new "$session" --window "$1" --json -- env ${SSHPICK_CONFIG:+SSHPICK_CONFIG="$CONFIG"} "$SELF" --session "$1")
        id=$(printf '%s' "$out" | "$JQ" -r '.session_id')
        win=$(printf '%s' "$out" | "$JQ" -r '.initial_windows[0].window_id // empty')
    fi
    switch_to "$id" "$win"
}

case "$1" in
    --rows)         list_rows; exit ;;
    --fav)          toggle_favorite "$2"; exit ;;
    --filter)       set_filter "$2"; exit ;;
    --tag-step)     step_filter "$2"; exit ;;
    --sort)         if [ "$(sort_mode)" = alpha ]; then m=recent; else m=alpha; fi
                    mkdir -p "$STATE" && echo "$m" > "$STATE/sort"
                    echo "change-list-label($(list_label "$(cat "$RUN/filter")"))+reload($SELF --rows)"; exit ;;
    --info)         info "$2"; exit ;;
    --delete)       delete_host "$2"; exit ;;
    --form-summary) form_summary; exit ;;
    --form-next)    form_next "$2"; exit ;;
    --form-prev)    form_prev "$2"; exit ;;
    --session)      ssh_session "$2" ;;
    --version)      echo "sshpick $VERSION"; exit ;;
    --update)       update; exit ;;
    --here)         need ;;
    --inline)       INLINE=1; need ;;
    -h|--help)      cat <<EOF; exit ;;
usage: sshpick [--here | --inline | --version | --update]
  (no option)  in Rex: open the picker in a floating popup over this tab
               elsewhere: same as --inline
  --here       run the Rex picker in this terminal instead of a popup
  --inline     plain picker without Rex: connect with ssh in this terminal
  --version    print the version
  --update     update to the latest version from GitHub
EOF
    *)              if [ -z "$REX_SESSION" ]; then INLINE=1; need; else need; open_popup && exit 0; fi ;;
esac
export INLINE

RUN=$(mktemp -d) && export RUN
trap 'rm -rf "$RUN"' EXIT

while :; do
    [ -n "$INLINE" ] && [ -n "$again" ] && printf '\033[2J\033[H'  # clear what an add or edit left behind
    again=1
    rm -f "$RUN/hosts"
    echo all > "$RUN/filter"
    rows=$(list_rows)
    { echo all; printf '%s\n' "$rows" | cut -f2 | grep -vx -- - | sort -u; } | tr '\n' ' ' > "$RUN/tags"
    sel=$(printf '%s\n' "$rows" | fzf --ansi --style=full --layout=reverse --border=rounded \
        --delimiter='\t' --with-nth=3 --id-nth=1 --track --tiebreak=index ${INLINE:+--height=80%} \
        --border-label=' sshpick ' \
        --footer='⇥ tags  ^f fav  ^o sort  ^n add  ^d delete' \
        --input-label=' Search ' --list-label="$(list_label all)" \
        --header="$(tag_header)" --header-label=' Tags (tab / click) ' \
        --preview="$SELF --info {1}" --preview-window='right,35%' --preview-label=' Details ' \
        --bind 'click-header:transform($SELF --filter $FZF_CLICK_HEADER_WORD)' \
        --bind 'tab:transform($SELF --tag-step 1)' \
        --bind 'btab:transform($SELF --tag-step -1)' \
        --bind 'ctrl-f:execute-silent($SELF --fav {1})+reload($SELF --rows)' \
        --bind 'ctrl-o:transform($SELF --sort)' \
        --bind 'ctrl-d:execute($SELF --delete {1})+reload($SELF --rows)' \
        --bind 'ctrl-n:become(printf "+add\n")' \
        --bind 'ctrl-e:become(printf "+edit\t%s\n" {1})' \
        --bind 'alt-enter:become(printf "+new\t%s\n" {1})') || exit 0
    action=$(printf '%s\n' "$sel" | cut -f1) target=$(printf '%s\n' "$sel" | cut -f2)
    force_new=
    case "$action" in
        +add)  host_flow && break ;;
        +new)  [ "$target" = "+add" ] && { host_flow && break; continue; }
               host=$target force_new=1; break ;;
        +edit) [ "$target" = "+add" ] && continue
               if is_editable "$target"; then
                   host_flow "$target" && break
               else
                   menu "Can't edit '$target'" "$(printf 'Only hosts added with sshpick\ncan be edited here.')" OK >/dev/null
               fi ;;
        *)     host=$action; break ;;
    esac
done

touch_recent "$host"
[ -n "$INLINE" ] && exec command ssh ${SSHPICK_CONFIG:+-F "$CONFIG"} "$host"
connect "$host" "$force_new"
